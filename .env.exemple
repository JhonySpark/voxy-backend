DATABASE_URL="postgresql://voxy_user:voxy_password@localhost:5432/voxy_db?schema=public"

# ==========================================
# CLOUDFLARE R2 (S3 API)
# ==========================================
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="voxy-storage"
R2_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"

# ==========================================
# CHAT RETENTION & LIMITS
# ==========================================
CHAT_RETENTION_DAYS=60
MAX_AVATAR_SIZE=2097152
MAX_IMAGE_SIZE=10485760
MAX_AUDIO_SIZE=15728640
MAX_VIDEO_SIZE=26214400
MAX_DOC_SIZE=26214400