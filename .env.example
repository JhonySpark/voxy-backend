# ==========================================
# BANCO DE DADOS (PostgreSQL / Neon)
# ==========================================
DATABASE_URL="postgresql://user:password@localhost:5432/voxy_db?schema=public"

# ==========================================
# SERVIÇO DE E-MAIL (Resend)
# ==========================================
RESEND_API_URL="https://api.resend.com/emails"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Voxy <onboarding@resend.dev>"

# ==========================================
# LIVEKIT (WebRTC Audio & Video Engine)
# ==========================================
LIVEKIT_URL="wss://voxy-livekit.d4rkside.com.br"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# ==========================================
# AUTENTICAÇÃO & SEGURANÇA
# ==========================================
JWT_SECRET="Ptone@2991"
JWT_EXPIRES_IN="7d"

# ==========================================
# CLOUDFLARE R2 / S3 STORAGE
# ==========================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="voxy-storage"
R2_ENDPOINT=""
R2_PUBLIC_URL=""

# ==========================================
# SERVIDOR & RETENÇÃO
# ==========================================
PORT=3000
HOST="0.0.0.0"
CHAT_RETENTION_DAYS=60
MAX_AVATAR_SIZE=2097152
MAX_IMAGE_SIZE=10485760
MAX_AUDIO_SIZE=15728640
MAX_VIDEO_SIZE=26214400
MAX_DOC_SIZE=26214400

# ==========================================
# OBSERVABILIDADE & MONITORAMENTO (Better Stack)
# ==========================================
# Token de fonte (Source Token) do Better Stack Telemetry / Logtail (Free Tier)
# Se vazio, os logs continuam normalmente no console local sem envio externo.
BETTER_STACK_SOURCE_TOKEN=""
# Ingesting Host (se a sua source estiver no datacenter EU/Frankfurt, ex: https://s12345.eu-nbg-2.betterstackdata.com)
# Deixe vazio para usar o padrão dos EUA (https://in.logs.betterstack.com)
BETTER_STACK_ENDPOINT=""

