// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  avatarUrl   String?
  avatarKey   String?
  displayName String?
  bio         String?
  bannerUrl   String?
  bannerKey   String?
  bannerColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  birthDate          DateTime?
  isEmailVerified    Boolean           @default(false)
  emailVerifiedAt    DateTime?
  ageClassification  AgeClassification @default(UNKNOWN)
  ageSignalSource    AgeSignalSource   @default(NONE)
  ageSignalCheckedAt DateTime?
  isSuspended        Boolean           @default(false)
  suspendedReason    String?
  suspendedAt        DateTime?

  // Relacionamentos
  friends           Friendship[] @relation("UserFriends")
  friendsOf         Friendship[] @relation("FriendOfUser")
  blockedUsers      BlockedUser[] @relation("UserBlocks")
  blockedByUsers    BlockedUser[] @relation("BlockedUsers")
  sentMessages      Message[]    @relation("SentMessages")
  receivedMessages  Message[]    @relation("ReceivedMessages")
  ownedServers      Server[]       @relation("ServerOwner")
  serverMemberships ServerMember[]
  serverBans        ServerBan[]    @relation("BannedFromServers")
  channelMessages   ChannelMessage[]
  messageReactions        MessageReaction[]        @relation("UserMessageReactions")
  channelMessageReactions ChannelMessageReaction[] @relation("UserChannelMessageReactions")
  reportsSent             ModerationReport[]       @relation("UserReportsSent")
  reportsReceived         ModerationReport[]       @relation("UserReportsReceived")
  securityAuditLogs       SecurityAuditLog[]       @relation("AuditLogsActed")
}

enum ReportTargetType {
  USER
  SERVER
  STREAM
}

enum ReportReason {
  CHILD_SAFETY_EXPLOITATION
  HARASSMENT_BULLYING
  HATE_SPEECH
  SEXUAL_CONTENT
  VIOLENCE_THREATS
  SELF_HARM
  SPAM_SCAM
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum AuditLogAction {
  SERVER_CREATED
  STREAM_STARTED
  MEMBER_MUTED
  MEMBER_UNMUTED
  MEMBER_KICKED
  MEMBER_BANNED
  MEMBER_UNBANNED
  REPORT_CREATED
  REPORT_RESOLVED
  SERVER_SUSPENDED
  SERVER_UNSUSPENDED
  USER_SUSPENDED
  USER_UNSUSPENDED
}

enum AgeClassification {
  UNKNOWN
  CHILD
  TEEN
  ADULT
}

enum AgeSignalSource {
  NONE
  WINDOWS_OS
  DECLARED
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
}


model Friendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("PENDING") // PENDING, ACCEPTED
  createdAt DateTime @default(now())
  
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  userId    String
  blockedId String
  createdAt DateTime @default(now())

  user      User     @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedId])
  @@index([userId])
  @@index([blockedId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isEdited   Boolean  @default(false)

  replyToId  String?
  replyTo    Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[] @relation("MessageReplies")

  sender      User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  attachments Attachment[]
  reactions   MessageReaction[]

  @@index([replyToId])
}

model Server {
  id              String                 @id @default(uuid())
  name            String
  inviteCode      String                 @unique
  iconUrl         String?
  iconKey         String?
  ownerId         String
  deletedAt       DateTime?
  is18Plus        Boolean                @default(false)
  isSuspended     Boolean                @default(false)
  suspendedReason String?
  suspendedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  owner           User                   @relation("ServerOwner", fields: [ownerId], references: [id])
  members         ServerMember[]
  channels        Channel[]
  bans            ServerBan[]
  rolePermissions ServerRolePermission[]
  reports         ModerationReport[]     @relation("ServerReports")
  securityAuditLogs SecurityAuditLog[]   @relation("ServerAuditLogs")
}

model ServerMember {
  id          String    @id @default(uuid())
  serverId    String
  userId      String
  role        String    @default("MEMBER") // OWNER, ADMIN, MODERATOR, MEMBER
  isMuted     Boolean   @default(false)
  mutedReason String?
  mutedUntil  DateTime?
  createdAt   DateTime  @default(now())

  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

model ServerBan {
  id        String   @id @default(uuid())
  serverId  String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation("BannedFromServers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
}

model ServerRolePermission {
  id                String   @id @default(uuid())
  serverId          String
  role              String   // ADMIN, MODERATOR, MEMBER
  canInvite         Boolean  @default(true)
  canDeleteMessages Boolean  @default(false)
  canKickMembers    Boolean  @default(false)
  canBanMembers     Boolean  @default(false)
  canMuteMembers    Boolean  @default(false)
  canManageChannels Boolean  @default(false)
  canManageServer   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  server            Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, role])
  @@index([serverId])
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("TEXT") // TEXT, VOICE
  serverId  String
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages  ChannelMessage[]
}

model ChannelMessage {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  channelId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  isEdited   Boolean  @default(false)

  replyToId  String?
  replyTo    ChannelMessage?  @relation("ChannelMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    ChannelMessage[] @relation("ChannelMessageReplies")

  sender      User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  reactions   ChannelMessageReaction[]

  @@index([replyToId])
}

model Attachment {
  id               String          @id @default(uuid())
  fileName         String
  fileKey          String
  fileType         String          // IMAGE, AUDIO, VIDEO, DOCUMENT
  mimeType         String
  fileSize         Int             // tamanho comprimido em bytes
  originalSize     Int             // tamanho antes da compressão em bytes
  thumbnailKey     String?         // Chave R2 da thumbnail/capa (WebP ~10-15KB)
  url              String?         // URL pública ou de cache (para avatares/públicos)
  createdAt        DateTime        @default(now())

  // Associação opcional com mensagem direta
  messageId        String?
  message          Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Associação opcional com mensagem de canal
  channelMessageId String?
  channelMessage   ChannelMessage? @relation(fields: [channelMessageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([channelMessageId])
  @@index([createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid())
  emoji     String
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user      User     @relation("UserMessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model ChannelMessageReaction {
  id               String         @id @default(uuid())
  emoji            String
  userId           String
  channelMessageId String
  createdAt        DateTime       @default(now())

  user             User           @relation("UserChannelMessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  channelMessage   ChannelMessage @relation(fields: [channelMessageId], references: [id], onDelete: Cascade)

  @@unique([channelMessageId, userId])
  @@index([channelMessageId])
  @@index([userId])
}

model ModerationReport {
  id              String           @id @default(uuid())
  reporterId      String
  targetType      ReportTargetType
  targetUserId    String?
  targetServerId  String?
  targetChannelId String?
  reason          ReportReason
  description     String
  status          ReportStatus     @default(PENDING)
  resolutionNotes String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reporter        User             @relation("UserReportsSent", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser      User?            @relation("UserReportsReceived", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetServer    Server?          @relation("ServerReports", fields: [targetServerId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([targetUserId])
  @@index([targetServerId])
  @@index([targetType])
  @@index([status])
}

model SecurityAuditLog {
  id         String         @id @default(uuid())
  action     AuditLogAction
  actorId    String
  targetType String         // SERVER, USER, STREAM, REPORT, CHANNEL
  targetId   String?
  serverId   String?
  reason     String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  actor      User           @relation("AuditLogsActed", fields: [actorId], references: [id], onDelete: Cascade)
  server     Server?        @relation("ServerAuditLogs", fields: [serverId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([actorId])
  @@index([targetId])
  @@index([serverId])
  @@index([createdAt])
}

model SystemConfig {
  id                          String   @id @default("default")
  allowRegistrations          Boolean  @default(true)
  maxBetaUsers                Int      @default(50)
  allowScreenShare            Boolean  @default(true)
  maxVoiceParticipantsPerRoom Int      @default(8)
  maxScreenShareBitrateKbps   Int      @default(2500)
  maintenanceNotice           String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

