// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  avatarUrl   String?
  avatarKey   String?
  displayName String?
  bio         String?
  bannerUrl   String?
  bannerKey   String?
  bannerColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  friends           Friendship[] @relation("UserFriends")
  friendsOf         Friendship[] @relation("FriendOfUser")
  blockedUsers      BlockedUser[] @relation("UserBlocks")
  blockedByUsers    BlockedUser[] @relation("BlockedUsers")
  sentMessages      Message[]    @relation("SentMessages")
  receivedMessages  Message[]    @relation("ReceivedMessages")
  ownedServers      Server[]       @relation("ServerOwner")
  serverMemberships ServerMember[]
  serverBans        ServerBan[]    @relation("BannedFromServers")
  channelMessages   ChannelMessage[]
}

model Friendship {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("PENDING") // PENDING, ACCEPTED
  createdAt DateTime @default(now())
  
  user      User     @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend    User     @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  userId    String
  blockedId String
  createdAt DateTime @default(now())

  user      User     @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedId])
  @@index([userId])
  @@index([blockedId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  replyToId  String?
  replyTo    Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    Message[] @relation("MessageReplies")

  sender      User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User         @relation("ReceivedMessages", fields: [receiverId], references: [id])
  attachments Attachment[]

  @@index([replyToId])
}

model Server {
  id         String    @id @default(uuid())
  name       String
  inviteCode String    @unique
  iconUrl    String?
  iconKey    String?
  ownerId    String
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner           User                   @relation("ServerOwner", fields: [ownerId], references: [id])
  members         ServerMember[]
  channels        Channel[]
  bans            ServerBan[]
  rolePermissions ServerRolePermission[]
}

model ServerMember {
  id        String   @id @default(uuid())
  serverId  String
  userId    String
  role      String   @default("MEMBER") // OWNER, ADMIN, MODERATOR, MEMBER
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
}

model ServerBan {
  id        String   @id @default(uuid())
  serverId  String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user      User     @relation("BannedFromServers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
}

model ServerRolePermission {
  id                String   @id @default(uuid())
  serverId          String
  role              String   // ADMIN, MODERATOR, MEMBER
  canInvite         Boolean  @default(true)
  canDeleteMessages Boolean  @default(false)
  canKickMembers    Boolean  @default(false)
  canBanMembers     Boolean  @default(false)
  canManageChannels Boolean  @default(false)
  canManageServer   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  server            Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, role])
  @@index([serverId])
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("TEXT") // TEXT, VOICE
  serverId  String
  createdAt DateTime @default(now())

  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages  ChannelMessage[]
}

model ChannelMessage {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  channelId  String
  createdAt  DateTime @default(now())

  replyToId  String?
  replyTo    ChannelMessage?  @relation("ChannelMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    ChannelMessage[] @relation("ChannelMessageReplies")

  sender      User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([replyToId])
}

model Attachment {
  id               String          @id @default(uuid())
  fileName         String
  fileKey          String
  fileType         String          // IMAGE, AUDIO, VIDEO, DOCUMENT
  mimeType         String
  fileSize         Int             // tamanho comprimido em bytes
  originalSize     Int             // tamanho antes da compressão em bytes
  thumbnailKey     String?         // Chave R2 da thumbnail/capa (WebP ~10-15KB)
  url              String?         // URL pública ou de cache (para avatares/públicos)
  createdAt        DateTime        @default(now())

  // Associação opcional com mensagem direta
  messageId        String?
  message          Message?        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // Associação opcional com mensagem de canal
  channelMessageId String?
  channelMessage   ChannelMessage? @relation(fields: [channelMessageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([channelMessageId])
  @@index([createdAt])
}

